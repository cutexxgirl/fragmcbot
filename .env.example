# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Main administrator Telegram ID
ADMIN_ID=123456789

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fragment_bot

# Public API server settings
API_PORT=3000
API_HOST=0.0.0.0

# Internal File API base URL
FILE_API_URL=http://127.0.0.1:3001/api

# Subscriber group IDs
GROUP_NOVICE_ID=-100xxxxxxxxxx
GROUP_ADEPT_ID=-100xxxxxxxxxx
GROUP_LEGEND_ID=-100xxxxxxxxxx
GROUP_SPARK_ID=-100xxxxxxxxxx

# Support group ID
SUPPORT_GROUP_ID=-100xxxxxxxxxx

# Promo group ID
GROUP_PROMO_ID=-100xxxxxxxxxx

# Main public channel ID
CHANNEL=-100xxxxxxxxxx

# Closed private channel ID
CLOSED_CHANNEL_ID=-100xxxxxxxxxx

# Optional public channel link for promo checks
CHANNEL_LINK=@fragmcru

# Environment
NODE_ENV=development
