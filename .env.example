# Токен бота из @BotFather
BOT_TOKEN=your_bot_token_here

# ID главного администратора (Telegram ID)
ADMIN_ID=123456789

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/fragment_bot

# Порт API сервера
API_PORT=3000
API_HOST=0.0.0.0

# ID групп подписчиков разных уровней
GROUP_NOVICE_ID=-100xxxxxxxxxx
GROUP_ADEPT_ID=-100xxxxxxxxxx
GROUP_LEGEND_ID=-100xxxxxxxxxx

# ID группы поддержки
SUPPORT_GROUP_ID=-100xxxxxxxxxx

# ID промо-группы
GROUP_PROMO_ID=-100xxxxxxxxxx

# ID основного канала
CHANNEL=-100xxxxxxxxxx

# Окружение (development / production)
NODE_ENV=development
